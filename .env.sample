# Template for the config used by Yakushahyoubanki_NEL.
# To set up:  cp .env.sample .env  and edit (the project .env is gitignored).
# config/config.py loads the project .env first, then falls back to
# /workspace/BLINK/.env for any keys it does not set. Values here never override
# variables already set in the shell.

# --- Paths ---
# Workspace root holding the per-method repos (In_Context_EL / DeepEL / SumMC /
# GENRE / ReFinED / OneNet / ...). nel_models builds each method's venv+script
# path from this.
YAKUSYA_WORKSPACE=/workspace
# Contact string for the Wikidata API User-Agent (etiquette requires one).
# Default when unset: the project repo URL. Set to your email if you prefer.
#YAKUSYA_CONTACT=you@example.com

# Reproducibility seed for the 4 dataset splits (pair/entity/temporal/book).
# Changing it changes every generated split — keep at 52313 to reproduce results.
#YAKUSYA_SPLIT_SEED=52313

# Optional: select an alternative dataset variant.
# Default = daime_eval_full (the 2214-mention 代目 eval benchmark, eval-only).
# Notable options: daime_eval (the frozen 1479 subset the published numbers were
# measured on) | relinked_yr_v1 (training / trained-model runs) | clean | arc |
# fix | relinked | relinked_yr | xgen_t1 | daime_ft_w100 | mahanama ...
#YAKUSYA_DATASET=relinked_yr_v1

# Optional: override data / experiments roots directly.
#YAKUSYA_DATA_ROOT=/workspace/Yakushahyoubanki_NEL/data/dataset_ja/yakusya_with_theaters
#YAKUSYA_EXPERIMENTS_ROOT=/workspace/Yakushahyoubanki_NEL/experiment/experiments

# --- API keys (needed by the LLM rerankers / llmd / mad subprocesses) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
HF_TOKEN=hf_...
